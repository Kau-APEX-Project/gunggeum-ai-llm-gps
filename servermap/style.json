{
  "version": 8,
  "name": "경복궁",
  "glyphs": "local://{fontstack}/{range}",
  "center": [
    126.976902,
    37.579766
  ],
  "zoom": 16,
  "sources": {
    "bg-vec": {
      "type": "vector",
      "url": "pmtiles://tiles/palace.pmtiles",
      "attribution": "지도·데이터 © OpenStreetMap 기여자"
    },
    "palace-mask": {
      "type": "geojson",
      "data": "data/mask.geojson"
    },
    "palace-boundary": {
      "type": "geojson",
      "data": "data/boundary.geojson"
    },
    "osm-ways": {
      "type": "geojson",
      "data": "data/paths.geojson"
    },
    "palace-places": {
      "type": "geojson",
      "data": "data/places.geojson"
    },
    "user-pins": {
      "type": "geojson",
      "data": "data/pins.geojson"
    }
  },
  "layers": [
    {
      "id": "ground",
      "type": "background",
      "paint": {
        "background-color": "#f4f2ee"
      }
    },
    {
      "id": "bg-landuse",
      "type": "fill",
      "source": "bg-vec",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "wood",
            "forest",
            "scrub",
            "grass",
            "grassland",
            "meadow",
            "park",
            "garden",
            "nature_reserve"
          ],
          "#dee7d3",
          [
            "parking"
          ],
          "#e8e3d8",
          "#e8e6dc"
        ],
        "fill-opacity": 0.9
      }
    },
    {
      "id": "bg-water",
      "type": "fill",
      "source": "bg-vec",
      "source-layer": "water",
      "paint": {
        "fill-color": "#c4d9e4"
      }
    },
    {
      "id": "bg-waterway",
      "type": "line",
      "source": "bg-vec",
      "source-layer": "waterway",
      "layout": {
        "line-cap": "round"
      },
      "paint": {
        "line-color": "#c4d9e4",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          15,
          1,
          20,
          3
        ]
      }
    },
    {
      "id": "bg-road",
      "type": "line",
      "source": "bg-vec",
      "source-layer": "road",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ece4d4",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          15,
          1.5,
          18,
          4,
          20,
          8
        ]
      }
    },
    {
      "id": "bg-path",
      "type": "line",
      "source": "bg-vec",
      "source-layer": "path",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#e1d9c8",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          15,
          0.6,
          20,
          2.5
        ]
      }
    },
    {
      "id": "bg-building",
      "type": "fill",
      "source": "bg-vec",
      "source-layer": "building",
      "paint": {
        "fill-color": "#e4dccb",
        "fill-outline-color": "#d2c8b2"
      }
    },
    {
      "id": "bg-barrier",
      "type": "line",
      "source": "bg-vec",
      "source-layer": "barrier",
      "paint": {
        "line-color": "#c8b696",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          15,
          0.8,
          20,
          2.2
        ]
      }
    },
    {
      "id": "palace-mask-fill",
      "type": "fill",
      "source": "palace-mask",
      "paint": {
        "fill-color": "#dedae0",
        "fill-opacity": 1
      }
    },
    {
      "id": "palace-boundary-line",
      "type": "line",
      "source": "palace-boundary",
      "paint": {
        "line-color": "#8a7f74",
