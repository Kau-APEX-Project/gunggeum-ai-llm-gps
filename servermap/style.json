        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "osm-ways-line",
      "type": "line",
      "source": "osm-ways",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "case",
          [
            "boolean",
            [
              "feature-state",
              "selected"
            ],
            false
          ],
          "#e8590c",
          [
            "==",
            [
              "get",
              "highway"
            ],
            "steps"
          ],
          "#b0653f",
          "#3f6cb0"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          15,
          [
            "case",
            [
              "boolean",
              [
                "feature-state",
                "selected"
              ],
              false
            ],
            3,
            1.5
          ],
          18,
          [
            "case",
            [
              "boolean",
              [
                "feature-state",
                "selected"
              ],
              false
            ],
            5,
            3
          ],
          20,
          [
            "case",
            [
              "boolean",
              [
                "feature-state",
                "selected"
              ],
              false
            ],
            8,
            5
          ]
        ]
      }
    },
    {
      "id": "palace-places-label",
      "type": "symbol",
      "source": "palace-places",
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          15,
          11,
          19,
          14
        ],
        "text-max-width": 8,
        "text-anchor": "top",
        "text-offset": [
          0,
          0.6
        ]
      },
      "paint": {
        "text-color": "#5c4a36",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "user-pins-circle",
      "type": "circle",
      "source": "user-pins",
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          15,
          [
            "case",
            [
              "!=",
              [
                "get",
                "icon"
              ],
              ""
            ],
            8,
            5
          ],
          18,
          [
            "case",
            [
              "!=",
              [
                "get",
                "icon"
              ],
              ""
            ],
            11,
            7
          ],
          20,
          [
            "case",
            [
              "!=",
              [
                "get",
                "icon"
              ],
              ""
            ],
            14,
            10
          ]
        ],
        "circle-color": [
          "get",
          "color"
        ],
        "circle-stroke-color": "#ffffff",
        "circle-stroke-width": 2
      }
    }
  ]
}
