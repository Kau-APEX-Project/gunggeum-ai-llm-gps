# 서버 키. 이 파일을 .env 로 복사해서 채움 (.env 는 git 에 안 올라감)
# 답변 LLM (GPT-6 Luna)
OPENAI_API_KEY=
# 선택: 답변 LLM 추론 강도 (비우면 none)
LUNA_EFFORT=
# Titan 임베딩 (AWS Bedrock). EC2 에 Bedrock 권한 IAM 역할을 붙이면 키 두 개는 비워도 됨
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
# DB (docker-compose.yml 의 db). 비밀번호를 바꾸면 DB_PASSWORD 와 DATABASE_URL 둘 다
DB_PASSWORD=gbg
DATABASE_URL=postgresql://postgres:gbg@127.0.0.1:5433/gbg
